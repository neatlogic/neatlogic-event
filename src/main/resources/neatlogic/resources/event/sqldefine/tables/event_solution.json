    },
    {
      "name": "lcd",
      "type": "timestamp(3)",
      "description": "更新时间。"
    },
    {
      "name": "content",
      "type": "mediumtext",
      "description": "内容。"
    }
  ],
  "indexes": [
    {
      "name": "PRIMARY",
      "type": "BTREE",
      "unique": true,
      "primary": true,
      "columns": [
        "id"
      ],
      "description": "主键索引，覆盖 id 字段，适合用于唯一定位记录和主表关联查询。"
    }
  ]
